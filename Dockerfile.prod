# ---------- Build stage ----------
FROM node:alpine-14 AS builder

WORKDIR /app

# Copy package.json and lock file first for better caching
COPY package*.json ./

# Install all dependencies (including devDependencies for build tools)
RUN npm install

# Copy the full source
COPY . .

# Run build (if you’re using TypeScript or bundling)
RUN npm run build

# ---------- Production stage ----------
FROM node:alpine-14 AS production

WORKDIR /app

# Copy only package.json + lock file to install production deps
COPY package*.json ./

# Install only production dependencies
RUN npm install --only=production

# Copy built app from builder
COPY --from=builder /app/dist ./dist

# If you need other files (like migrations, configs), copy them too
# COPY --from=builder /app/prisma ./prisma

# Expose app port (adjust as needed)
EXPOSE 3000

# Start the backend service
CMD ["npm", "start"]